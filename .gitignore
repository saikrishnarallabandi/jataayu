# eval/: track SOURCE, exclude vendored venvs, bulk data and run logs.
# A bare `eval/` here silently untracked 70+ source files, including runners
# that produced published numbers. Narrowed 2026-07-18.
eval/.venv*/
eval/**/__pycache__/
eval/data/agentharm/
eval/data/injecagent/test_cases_*.json
eval/results/qwen_scores/eval_cache.jsonl
eval/results/**/*.log
downloads/
runs/
eggs/
.eggs/
lib/
lib64/
parts/
# training/: track CODE + configs, exclude datasets, adapters and checkpoints.
# A bare `training/` untracked the entire pipeline that trained the published
# v0.1 model — it existed only on one disk. Narrowed 2026-07-18.
training/**/data/
training/**/adapters/
training/**/checkpoints/
training/**/*.safetensors
training/**/__pycache__/
training/**/logs/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
